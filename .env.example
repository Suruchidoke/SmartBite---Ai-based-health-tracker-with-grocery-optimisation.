# SmartBite Environment Configuration Example
# Copy to .env and configure for your local/production environment

# Flask Server
SMARTBITE_PORT=5000
SMARTBITE_DEBUG=True
FLASK_ENV=development

# Security Secrets (Generate random strings for production)
SMARTBITE_SECRET_KEY=dev-smartbite-change-in-production-key-99128
SMARTBITE_JWT_SECRET=dev-jwt-secret-change-in-production-88371

# Database Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=auto_diet_db

# Google Gemini AI Integration
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
